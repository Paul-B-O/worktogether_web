{% extends 'base.html.twig' %}

{% block title %}Nos offres - WorkTogether{% endblock %}

{% block body %}
    <h1>Nos offres</h1>

    <table>
        <thead>
            <tr>
                <th>Offre</th>
                <th>Unités</th>
                <th>Prix mensuel</th>
                <th>Remise annuelle</th>
            </tr>
        </thead>
        <tbody>
            {% for offer in offers %}
                <tr>
                    <td>{{ offer.name }}</td>
                    <td>{{ offer.unitCount }}</td>
                    <td>{{ offer.monthlyPrice|number_format(2, ',', ' ') }} €</td>
                    <td>{{ offer.annualDiscount|number_format(0) }} %</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucune offre disponible.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}