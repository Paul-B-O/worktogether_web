{% extends 'base.html.twig' %}

{% block title %}Mes unités - WorkTogether{% endblock %}

{% block body %}
    <h1>Mes unités</h1>

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Unité</th>
                <th>Rack</th>
                <th>Usage</th>
                <th>Fin du contrat</th>
            </tr>
        </thead>
        <tbody>
            {% for assignment in assignments %}
                <tr>
                    <td>{{ assignment.customName }}</td>
                    <td>{{ assignment.unit.number }}</td>
                    <td>{{ assignment.unit.rack.number }}</td>
                    <td>{{ assignment.unitType.label }}</td>
                    <td>{{ assignment.endDate|date('d/m/Y') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Vous n'avez aucune unité en ce moment. <a href="{{ path('app_offers') }}">Voir les offres</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
