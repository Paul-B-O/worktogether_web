{% extends 'base.html.twig' %}

{% block title %}Accueil - WorkTogether{% endblock %}

{% block body %}
    <h1>WorkTogether</h1>

    {% if app.user %}
        <p>Connecté en tant que {{ app.user.userIdentifier }}.</p>
        <a href="{{ path('app_logout') }}">Se déconnecter</a>
    {% else %}
        <a href="{{ path('app_login') }}">Se connecter</a>
        <a href="{{ path('app_register') }}">S'inscrire</a>
    {% endif %}
{% endblock %}